---
import Base from '../layouts/Base.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'resources');
const { heading, intro, groups = [], finePrint } = page.data;
---
<Base title={page.data.title} description={page.data.description}>
  <section class="page-header">
    <div class="wrap">
      <h1>{heading}</h1>
      <p>{intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap content">
      {groups.map((group) => (
        <div class="resource-group">
          <h2>{group.heading}</h2>
          {group.intro && <p class="group-intro">{group.intro}</p>}
          <ul class="resource-list">
            {group.links.map((item) => (
              <li>
                <a href={item.url} target="_blank" rel="noopener noreferrer">
                  <span class="resource-name">{item.name}<span class="ext" aria-hidden="true">&#8599;</span></span>
                  {item.desc && <span class="resource-desc">{item.desc}</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      {finePrint && <p class="fine-print">{finePrint}</p>}
    </div>
  </section>
</Base>

<style>
  .resource-group { margin-block: 2.5rem; }
  .resource-group:first-of-type { margin-top: 1rem; }
  .resource-group h2 { margin-bottom: 0.4rem; }
  .group-intro {
    color: var(--spruce-70);
    margin-bottom: 1.25rem;
    max-width: 52ch;
  }
  .resource-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--spruce-12);
    border-block: 1px solid var(--spruce-12);
  }
  .resource-list li { background: var(--paper); }
  .resource-list a {
    display: block;
    padding: 1.15rem 0.25rem;
    text-decoration: none;
    transition: background 120ms ease;
  }
  .resource-list a:hover { background: var(--spruce-05); }
  .resource-name {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--spruce);
  }
  .resource-list a:hover .resource-name { color: var(--gold); }
  .ext {
    font-family: var(--font-body);
    font-size: 0.8em;
    margin-left: 0.35rem;
    color: var(--gold);
  }
  .resource-desc {
    display: block;
    margin-top: 0.25rem;
    color: var(--spruce-70);
    font-size: 0.98rem;
  }
  .fine-print {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--spruce-12);
    color: var(--spruce-70);
    font-size: 0.92rem;
    font-style: italic;
    max-width: 60ch;
  }
</style>
